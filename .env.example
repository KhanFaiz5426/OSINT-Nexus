# OSINT Nexus — Environment Configuration
# Copy to .env and fill in values

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=OSINT Nexus
DEBUG=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=osintnexus
POSTGRES_PASSWORD=osintnexus_dev
POSTGRES_DB=osintnexus

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=osintnexus_dev

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── LLM / AI Keys (Phase 6) ────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── OSINT API Keys (Phase 3) ────────────────────────────────────────────────
GITHUB_TOKEN=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
