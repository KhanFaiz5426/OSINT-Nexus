# OSINT Nexus — Environment Configuration
# Copy to backend/.env and fill in values. Never commit .env to version control.
#
# SECURITY: All values here are development defaults. For production:
#   - Use strong, unique passwords (not the defaults below)
#   - Restrict CORS_ORIGINS to your actual frontend domain
#   - Set DEBUG=false
#   - Use TLS for all database connections

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=OSINT Nexus
DEBUG=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=osintnexus
POSTGRES_PASSWORD=osintnexus_dev
POSTGRES_DB=osintnexus

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=osintnexus_dev

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── CORS Origins (comma-separated, no trailing slash) ────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── LLM Provider Configuration ──────────────────────────────────────────────
# Supported providers: opencode, nvidia, openai, anthropic, ollama, none
# When set to "none" or empty, the core investigation pipeline works fully
# but AI planner and analyzer return deterministic defaults (no LLM calls).
#
# The investigation pipeline (collection, normalization, extraction, resolution,
# correlation, reporting) works completely without any LLM.
#
# Provider-specific defaults:
#   opencode:  base_url=https://opencode.ai/zen/v1, model=mimo-v2.5-free (fastest free)
#   nvidia:    base_url=https://integrate.api.nvidia.com/v1, model=minimaxai/minimax-m3
#   openai:    base_url=https://api.openai.com/v1, model=gpt-4o
#   anthropic: base_url=https://api.anthropic.com, model=claude-sonnet-4-20250514
#   ollama:    base_url=http://localhost:11434, model=llama3.1

LLM_PROVIDER=opencode
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# ── OpenCode Zen (free, fastest) ───────────────────────────────────────────
# Free tier with models like mimo-v2.5-free, big-pickle, nemotron-3-ultra-free
# Sign up at https://opencode.ai to get an API key.
# Then set:
#   LLM_PROVIDER=opencode
#   OPENCODE_API_KEY=sk-xxxx...

# ── NVIDIA NIM (free tier available) ────────────────────────────────────────
# NVIDIA provides free API credits for hosted models.
# Sign up at https://build.nvidia.com/ to get an API key.
# Then set:
#   LLM_PROVIDER=nvidia
#   NVIDIA_API_KEY=nvapi-xxxx...

# ── OpenAI (paid) ───────────────────────────────────────────────────────────
# Requires a paid OpenAI account. Set:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-xxxx...

# ── Anthropic (paid) ────────────────────────────────────────────────────────
# Requires a paid Anthropic account. Set:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-xxxx...

# ── Ollama (free, local) ────────────────────────────────────────────────────
# Run a local LLM with Ollama: https://ollama.com
# Install and pull a model: ollama pull llama3.1
# Then set:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1
#   LLM_BASE_URL=http://localhost:11434
# Ollama runs entirely on your machine — no API key needed.

# ── OSINT API Keys (optional — collectors with missing keys are skipped) ────
# Each collector checks for its key at startup. Collectors without keys
# are disabled; the investigation proceeds with remaining sources.

GITHUB_TOKEN=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=

# ── Collector Timeouts (seconds) ────────────────────────────────────────────
DNS_TIMEOUT=10
WHOIS_TIMEOUT=15
HTTP_TIMEOUT=30
CT_TIMEOUT=30
GITHUB_TIMEOUT=15
