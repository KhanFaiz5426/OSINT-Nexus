# ─────────────────────────────────────────────────────────────────────────────
# OSINT Nexus — Root .gitignore
# ─────────────────────────────────────────────────────────────────────────────
# Keep version-controlled: source code, tests, migrations, fixtures,
# configuration templates (e.g. .env.example), Docker compose, package manifests.
# Ignore: secrets, build artifacts, caches, dependency installs, runtime data.
# ─────────────────────────────────────────────────────────────────────────────


# ── Python: byte-compiled / optimized ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyo

# Distribution / packaging
*.egg-info/
*.egg
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Note: `lib/`, `lib64/`, `build/`, `dist/` are intentionally omitted here because
# they collide with source-code directories in this project (e.g. frontend/src/lib/).
# Add explicit `backend/lib/`, `backend/lib64/` patterns below if needed.

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# Installer / package manager caches
pip-wheel-metadata/
.pypoetry/
.pip/

# Type / stub caches
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
pyrightconfig.json.bak

# Linter / formatter caches & outputs
.ruff_cache/
.black/
.tox/
.nox/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
.cache
coverage.xml
coverage/
htmlcov/
*.cover
*.py,cover
.tox/
.noseids
nosetests.xml
report.xml
junit*.xml
test-results/
pytest-results/

# Jupyter
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Celery
celerybeat-schedule
celerybeat.pid

# mypy specific
.mypy.ini.bak

# Local script outputs / scratch
scratch/
scratch.py


# ── Node / Vite / Frontend build output ──────────────────────────────────────
node_modules/
.npm/
.yarn/
.pnp/
.pnp.js
.pnp.cjs
.pnp.loader.mjs
.pnp.node.json
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/unplugged
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.vite/
.vite-temp/
.next/
.nuxt/
out/
.output/
storybook-static/
.svelte-kit/
.angular/
.nest/

# Build outputs
backend/build/
backend/dist/
backend/coverage/
frontend/build/
frontend/dist/
frontend/coverage/

# Frontend package manifests — keep these tracked (NOT ignored):
#   package.json
#   package-lock.json
#   yarn.lock
#   pnpm-lock.yaml


# ── Environment / Secrets ────────────────────────────────────────────────────
# Real env files — never commit
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test.local

# Keep templates tracked
!.env.example
!.env.sample
!.env.template

# Secrets & credentials
*.pem
*.key
*.crt
*.cer
*.csr
*.p12
*.pfx
*.keystore
secrets/
secrets.yaml
secrets.yml
credentials/
credentials.json
credentials.yaml
credentials.yml
*.secret
api_keys.json
