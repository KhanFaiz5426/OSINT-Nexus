{
  "github": {
    "name": "GitHub",
    "url_pattern": "https://github.com/{username}",
    "method": "GET",
    "success_indicators": {
      "status_codes": [200],
      "body_contains": ["<title>"],
      "body_not_contains": ["Page not found", "404"]
    },
    "failure_indicators": {
      "status_codes": [404],
      "body_contains": ["Page not found"]
    },
    "rate_limit_rpm": 30,
    "timeout": 5.0,
    "enabled": true,
    "notes": "Public developer profiles. Reliable 200/404 response."
  },
